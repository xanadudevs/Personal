generator client {
  provider = "prisma-client-js"
}

datasource db {
  // PostgreSQL grátis (ex: Supabase). DATABASE_URL com pooling (porta 6543);
  // DIRECT_URL direta (porta 5432), usada pelo db push.
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Alterações manuais ao calendário base (src/lib/miudosData.ts): cada linha
// sobrepõe um dia.
model MiudosDay {
  date      String   @id // AAAA-MM-DD
  who       String? // B (Bruno) | R (Rita); null = mantém o calendário base
  notes     String? // notas separadas por " | "; null = mantém as base, "" = sem notas
  updatedAt DateTime @updatedAt
}
